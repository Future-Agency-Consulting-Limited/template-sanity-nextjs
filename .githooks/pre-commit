#!/bin/sh

# Attempt to load nvm (Node Version Manager)
# Hooks run in a non-interactive shell, so nvm is often not available by default.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# 1. Install/Use correct Node version
nvm install
if [ $? -ne 0 ]; then
    echo "Error: 'nvm install' failed."
    exit 1
fi

# Add pnpm to PATH (for standalone installations)
# This is required because non-interactive shells don't load .bashrc/.zshrc
export PNPM_HOME="$HOME/.local/share/pnpm"
[ -d "$PNPM_HOME" ] && export PATH="$PNPM_HOME:$PATH"

# 2. Typegen
pnpm run typegen
if [ $? -ne 0 ]; then
    echo "Error: Typegen did not complete successfully"
    exit 1
fi

# 3. Check formatting
pnpm run format:check
if [ $? -ne 0 ]; then
    echo "Error: Formatting check failed. Please run 'pnpm run format' to fix."
    exit 1
fi

# 4. Linting
pnpm run lint
if [ $? -ne 0 ]; then
    echo "Error: Linting failed. Please run 'pnpm run lint:fix' to fix."
    exit 1
fi

exit 0
