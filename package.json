{
  "name": "insert-project-name",
  "private": true,
  "version": "1.0.0",
  "description": "INSERT PROJECT DESCRIPTION",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm run --parallel build",
    "fix-all": "pnpm run format-fix && pnpm run lint-fix && pnpm run typegen",
    "format-check": "prettier . --check",
    "format-fix": "prettier . --write",
    "lint-check": "pnpm run --dir apps/studio lint-check && pnpm run --dir apps/website lint-check",
    "lint-fix": "pnpm run --dir apps/studio lint-fix && pnpm run --dir apps/website lint-fix",
    "deploy": "pnpm run --dir apps/studio deploy && pnpm run --dir apps/website build",
    "prepare": "husky install",
    "typegen": "pnpm run --dir apps/studio typegen"
  },
  "lint-staged": {
    "apps/studio/**/*.{js,jsx,ts,tsx,mjs}": [
      "pnpm --dir apps/studio exec eslint"
    ],
    "apps/website/**/*.{js,jsx,ts,tsx,mjs}": [
      "pnpm --dir apps/studio exec eslint"
    ],
    "*.{js,jsx,ts,tsx,json,md,css,html,yml,yaml}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.1.3"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
